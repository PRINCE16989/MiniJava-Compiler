MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 16
MOVE TEMP 4 HALLOCATE 12
HSTORE TEMP 3 0 LS_Start
HSTORE TEMP 3 4 LS_Print
HSTORE TEMP 3 8 LS_Search
HSTORE TEMP 3 12 LS_Init
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 11 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 10 )
END

LS_Start [ 2 ]
BEGIN

MOVE TEMP 2 CALL BEGIN
MOVE TEMP 4 TEMP 0
HLOAD TEMP 5 TEMP 4 0
HLOAD TEMP 6 TEMP 5 12
RETURN TEMP 6
END ( TEMP 4 TEMP 1 )

MOVE TEMP 3 CALL BEGIN
MOVE TEMP 7 TEMP 0
HLOAD TEMP 8 TEMP 7 0
HLOAD TEMP 9 TEMP 8 4
RETURN TEMP 9
END ( TEMP 7 )

PRINT 9999

PRINT CALL BEGIN
MOVE TEMP 10 TEMP 0
HLOAD TEMP 11 TEMP 10 0
HLOAD TEMP 12 TEMP 11 8
RETURN TEMP 12
END ( TEMP 10 8 )

PRINT CALL BEGIN
MOVE TEMP 13 TEMP 0
HLOAD TEMP 14 TEMP 13 0
HLOAD TEMP 15 TEMP 14 8
RETURN TEMP 15
END ( TEMP 13 12 )

PRINT CALL BEGIN
MOVE TEMP 16 TEMP 0
HLOAD TEMP 17 TEMP 16 0
HLOAD TEMP 18 TEMP 17 8
RETURN TEMP 18
END ( TEMP 16 17 )

PRINT CALL BEGIN
MOVE TEMP 19 TEMP 0
HLOAD TEMP 20 TEMP 19 0
HLOAD TEMP 21 TEMP 20 8
RETURN TEMP 21
END ( TEMP 19 50 )

RETURN 55
END

LS_Print [ 1 ]
BEGIN

MOVE TEMP 1 1
L2	CJUMP LE TEMP 1 MINUS BEGIN
HLOAD TEMP 2 TEMP 0 8
RETURN TEMP 2
END
 1 L4
CJUMP MINUS 1 LE TEMP 1 MINUS BEGIN
HLOAD TEMP 2 TEMP 0 8
RETURN TEMP 2
END
 1 L3

L3	
PRINT BEGIN
MOVE TEMP 4 PLUS BEGIN
HLOAD TEMP 3 TEMP 0 4
RETURN TEMP 3
END
 TIMES 4 TEMP 1
HLOAD TEMP 5 TEMP 4 4
RETURN TEMP 5
END



MOVE TEMP 1 PLUS TEMP 1 1


JUMP L2
L4	NOOP

RETURN 0
END

LS_Search [ 2 ]
BEGIN

MOVE TEMP 2 1

MOVE TEMP 3 0

MOVE TEMP 4 0
L5	CJUMP LE TEMP 2 MINUS BEGIN
HLOAD TEMP 8 TEMP 0 8
RETURN TEMP 8
END
 1 L7
CJUMP MINUS 1 LE TEMP 2 MINUS BEGIN
HLOAD TEMP 8 TEMP 0 8
RETURN TEMP 8
END
 1 L6

L6	
MOVE TEMP 5 BEGIN
MOVE TEMP 10 PLUS BEGIN
HLOAD TEMP 9 TEMP 0 4
RETURN TEMP 9
END
 TIMES 4 TEMP 2
HLOAD TEMP 11 TEMP 10 4
RETURN TEMP 11
END



MOVE TEMP 6 PLUS TEMP 1 1

CJUMP LE TEMP 5 TEMP 1 L9
CJUMP MINUS 1 LE TEMP 5 TEMP 1 L11
 L11 CJUMP NE TEMP 5 TEMP 1 L9
CJUMP MINUS 1 NE TEMP 5 TEMP 1 L8

 
L8 
MOVE TEMP 7 0
 JUMP L10
L9 CJUMP LE TEMP 5 MINUS TEMP 6 1 L12
CJUMP MINUS 1 LE TEMP 5 MINUS TEMP 6 1 L13
 
L12 
MOVE TEMP 7 0
 JUMP L14
L13 
MOVE TEMP 3 1


MOVE TEMP 4 1


MOVE TEMP 2 BEGIN
HLOAD TEMP 12 TEMP 0 8
RETURN TEMP 12
END



L14 NOOP

L10 NOOP


MOVE TEMP 2 PLUS TEMP 2 1


JUMP L5
L7	NOOP

RETURN TEMP 4
END

LS_Init [ 2 ]
BEGIN

HSTORE TEMP 0 8 TEMP 1

HSTORE TEMP 0 4 BEGIN
MOVE TEMP 6 HALLOCATE  TIMES  PLUS TEMP 1 1  4
MOVE TEMP 7 4
L15 CJUMP  LE TEMP 7 MINUS  TIMES  PLUS TEMP 1 1  4  1 L16
HSTORE  PLUS TEMP 6 TEMP 7 0  0
MOVE TEMP 7 PLUS TEMP 7 4
JUMP L15
L16 HSTORE TEMP 6 0 TEMP 1
RETURN TEMP 6
END


MOVE TEMP 2 1

MOVE TEMP 3 PLUS BEGIN
HLOAD TEMP 8 TEMP 0 8
RETURN TEMP 8
END
 1
L17	CJUMP LE TEMP 2 MINUS BEGIN
HLOAD TEMP 9 TEMP 0 8
RETURN TEMP 9
END
 1 L19
CJUMP MINUS 1 LE TEMP 2 MINUS BEGIN
HLOAD TEMP 9 TEMP 0 8
RETURN TEMP 9
END
 1 L18

L18	
MOVE TEMP 4 TIMES 2 TEMP 2


MOVE TEMP 5 MINUS TEMP 3 3


HSTORE PLUS BEGIN
HLOAD TEMP 10 TEMP 0 4
RETURN TEMP 10
END
 TIMES 4 TEMP 2 4 PLUS TEMP 4 TEMP 5


MOVE TEMP 2 PLUS TEMP 2 1


MOVE TEMP 3 MINUS TEMP 3 1


JUMP L17
L19	NOOP

RETURN 0
END

