MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 4
MOVE TEMP 4 HALLOCATE 4
HSTORE TEMP 3 0 MultiObj_TestMultiple
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 3 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

MultiObj_TestMultiple [ 1 ]
BEGIN

MOVE TEMP 2 BEGIN
MOVE TEMP 6 HALLOCATE 4
MOVE TEMP 7 HALLOCATE 8
HSTORE TEMP 6 0 Counter_SetAndGet
MOVE TEMP 8 4
L2	CJUMP LE TEMP 8 7 L3
HSTORE PLUS TEMP 7 TEMP 8 0 0
MOVE TEMP 8 PLUS TEMP 8 4
JUMP L2
L3 HSTORE TEMP 7 0 TEMP 6
RETURN TEMP 7
END


MOVE TEMP 3 BEGIN
MOVE TEMP 9 HALLOCATE 4
MOVE TEMP 10 HALLOCATE 8
HSTORE TEMP 9 0 Counter_SetAndGet
MOVE TEMP 11 4
L4	CJUMP LE TEMP 11 7 L5
HSTORE PLUS TEMP 10 TEMP 11 0 0
MOVE TEMP 11 PLUS TEMP 11 4
JUMP L4
L5 HSTORE TEMP 10 0 TEMP 9
RETURN TEMP 10
END


MOVE TEMP 4 CALL BEGIN
MOVE TEMP 12 TEMP 2
HLOAD TEMP 13 TEMP 12 0
HLOAD TEMP 14 TEMP 13 0
RETURN TEMP 14
END ( TEMP 12 10 )

MOVE TEMP 5 CALL BEGIN
MOVE TEMP 15 TEMP 3
HLOAD TEMP 16 TEMP 15 0
HLOAD TEMP 17 TEMP 16 0
RETURN TEMP 17
END ( TEMP 15 20 )

PRINT TEMP 4

PRINT TEMP 5

RETURN 0
END

Counter_SetAndGet [ 2 ]
BEGIN

HSTORE TEMP 0 4 TEMP 1

RETURN BEGIN
HLOAD TEMP 2 TEMP 0 4
RETURN TEMP 2
END

END

