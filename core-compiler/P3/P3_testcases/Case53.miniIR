MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 8
MOVE TEMP 4 HALLOCATE 4
HSTORE TEMP 3 0 A_foo
HSTORE TEMP 3 4 A_bar
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 3 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 2 )
END

A_foo [ 2 ]
BEGIN

MOVE TEMP 5 CALL BEGIN
MOVE TEMP 6 BEGIN
MOVE TEMP 7 HALLOCATE 4
MOVE TEMP 8 HALLOCATE 4
HSTORE TEMP 7 0 B_getLambda
MOVE TEMP 9 4
L2	CJUMP LE TEMP 9 3 L3
HSTORE PLUS TEMP 8 TEMP 9 0 0
MOVE TEMP 9 PLUS TEMP 9 4
JUMP L2
L3 HSTORE TEMP 8 0 TEMP 7
RETURN TEMP 8
END

HLOAD TEMP 10 TEMP 6 0
HLOAD TEMP 11 TEMP 10 0
RETURN TEMP 11
END ( TEMP 6 )

MOVE TEMP 2 CALL BEGIN
MOVE TEMP 12 TEMP 5
HLOAD TEMP 13 TEMP 12 0
HLOAD TEMP 14 TEMP 13 0
RETURN TEMP 14
END ( TEMP 12 0 )

RETURN TEMP 2
END

A_bar [ 2 ]
BEGIN
CJUMP TEMP 1 L5
CJUMP MINUS 1 TEMP 1 L4
 
L4 
MOVE TEMP 2 1
 JUMP L6
L5 
MOVE TEMP 2 10

L6 NOOP

RETURN TEMP 2
END

B_getLambda [ 1 ]
BEGIN

MOVE TEMP 1 3

RETURN BEGIN
MOVE TEMP 9 HALLOCATE 4
MOVE TEMP 10 HALLOCATE 4
HSTORE TEMP 9 0 lambda_func0
 HSTORE TEMP 10 0 TEMP 9
RETURN TEMP 10
END

END

lambda_func0 [2]
BEGIN 
RETURN PLUS TEMP 1 CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 8
MOVE TEMP 4 HALLOCATE 4
HSTORE TEMP 3 0 A_foo
HSTORE TEMP 3 4 A_bar
MOVE TEMP 5 4
L7	CJUMP LE TEMP 5 3 L8
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L7
L8 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 4
RETURN TEMP 7
END ( TEMP 2 TEMP 8 )
END

