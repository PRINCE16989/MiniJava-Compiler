MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 4
MOVE TEMP 4 HALLOCATE 4
HSTORE TEMP 3 0 MethodReturn_TestMethodReturn
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 3 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

MethodReturn_TestMethodReturn [ 1 ]
BEGIN

MOVE TEMP 2 BEGIN
MOVE TEMP 6 HALLOCATE 4
MOVE TEMP 7 HALLOCATE 4
HSTORE TEMP 6 0 Operations_Triple
MOVE TEMP 8 4
L2	CJUMP LE TEMP 8 3 L3
HSTORE PLUS TEMP 7 TEMP 8 0 0
MOVE TEMP 8 PLUS TEMP 8 4
JUMP L2
L3 HSTORE TEMP 7 0 TEMP 6
RETURN TEMP 7
END


MOVE TEMP 3 CALL BEGIN
MOVE TEMP 9 TEMP 2
HLOAD TEMP 10 TEMP 9 0
HLOAD TEMP 11 TEMP 10 0
RETURN TEMP 11
END ( TEMP 9 10 )

PRINT TEMP 3

MOVE TEMP 4 CALL BEGIN
MOVE TEMP 12 TEMP 2
HLOAD TEMP 13 TEMP 12 0
HLOAD TEMP 14 TEMP 13 0
RETURN TEMP 14
END ( TEMP 12 TEMP 3 )

PRINT TEMP 4

MOVE TEMP 5 CALL BEGIN
MOVE TEMP 15 TEMP 2
HLOAD TEMP 16 TEMP 15 0
HLOAD TEMP 17 TEMP 16 0
RETURN TEMP 17
END ( TEMP 15 CALL BEGIN
MOVE TEMP 18 TEMP 2
HLOAD TEMP 19 TEMP 18 0
HLOAD TEMP 20 TEMP 19 0
RETURN TEMP 20
END ( TEMP 18 5 ) )

PRINT TEMP 5

RETURN 0
END

Operations_Triple [ 2 ]
BEGIN

RETURN TIMES TEMP 1 3
END

