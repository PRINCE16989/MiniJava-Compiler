MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 8
MOVE TEMP 4 HALLOCATE 8
HSTORE TEMP 3 0 ThisTest_UseThis
HSTORE TEMP 3 4 ThisTest_GetData
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 7 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

ThisTest_UseThis [ 1 ]
BEGIN

HSTORE TEMP 0 4 100

MOVE TEMP 1 CALL BEGIN
MOVE TEMP 2 TEMP 0
HLOAD TEMP 3 TEMP 2 0
HLOAD TEMP 4 TEMP 3 4
RETURN TEMP 4
END ( TEMP 2 )

PRINT TEMP 1

RETURN 0
END

ThisTest_GetData [ 1 ]
BEGIN

RETURN BEGIN
HLOAD TEMP 1 TEMP 0 4
RETURN TEMP 1
END

END

