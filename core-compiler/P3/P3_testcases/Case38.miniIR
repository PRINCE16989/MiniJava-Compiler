MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 4
MOVE TEMP 4 HALLOCATE 4
HSTORE TEMP 3 0 NoParam_TestNoParam
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 3 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

NoParam_TestNoParam [ 1 ]
BEGIN

MOVE TEMP 2 BEGIN
MOVE TEMP 5 HALLOCATE 8
MOVE TEMP 6 HALLOCATE 4
HSTORE TEMP 5 0 Constants_GetPi
HSTORE TEMP 5 4 Constants_GetMax
MOVE TEMP 7 4
L2	CJUMP LE TEMP 7 3 L3
HSTORE PLUS TEMP 6 TEMP 7 0 0
MOVE TEMP 7 PLUS TEMP 7 4
JUMP L2
L3 HSTORE TEMP 6 0 TEMP 5
RETURN TEMP 6
END


MOVE TEMP 3 CALL BEGIN
MOVE TEMP 8 TEMP 2
HLOAD TEMP 9 TEMP 8 0
HLOAD TEMP 10 TEMP 9 0
RETURN TEMP 10
END ( TEMP 8 )

MOVE TEMP 4 CALL BEGIN
MOVE TEMP 11 TEMP 2
HLOAD TEMP 12 TEMP 11 0
HLOAD TEMP 13 TEMP 12 4
RETURN TEMP 13
END ( TEMP 11 )

PRINT TEMP 3

PRINT TEMP 4

RETURN 0
END

Constants_GetPi [ 1 ]
BEGIN

RETURN 314
END

Constants_GetMax [ 1 ]
BEGIN

RETURN 100
END

