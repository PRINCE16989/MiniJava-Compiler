MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 4
MOVE TEMP 4 HALLOCATE 4
HSTORE TEMP 3 0 LengthExpr_TestLengthExpr
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 3 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

LengthExpr_TestLengthExpr [ 1 ]
BEGIN

MOVE TEMP 1 BEGIN
MOVE TEMP 5 HALLOCATE  TIMES  PLUS 5 1  4
MOVE TEMP 6 4
L2 CJUMP  LE TEMP 6 MINUS  TIMES  PLUS 5 1  4  1 L3
HSTORE  PLUS TEMP 5 TEMP 6 0  0
MOVE TEMP 6 PLUS TEMP 6 4
JUMP L2
L3 HSTORE TEMP 5 0 5
RETURN TEMP 5
END


HSTORE PLUS TEMP 1 TIMES 4 0 4 10

HSTORE PLUS TEMP 1 TIMES 4 1 4 20

HSTORE PLUS TEMP 1 TIMES 4 2 4 30

HSTORE PLUS TEMP 1 TIMES 4 3 4 40

HSTORE PLUS TEMP 1 TIMES 4 4 4 50

MOVE TEMP 2 BEGIN
HLOAD TEMP 7 TEMP 1 0
RETURN TEMP 7
END

PRINT TEMP 2

MOVE TEMP 3 4

PRINT TEMP 3

MOVE TEMP 4 BEGIN
MOVE TEMP 8 PLUS TEMP 1 TIMES 4 4
HLOAD TEMP 9 TEMP 8 4
RETURN TEMP 9
END


PRINT TEMP 4

RETURN 0
END

