MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 4
MOVE TEMP 4 HALLOCATE 4
HSTORE TEMP 3 0 NewExprTest_TestNewExpr
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 3 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

NewExprTest_TestNewExpr [ 1 ]
BEGIN

MOVE TEMP 1 CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 8
MOVE TEMP 4 HALLOCATE 4
HSTORE TEMP 3 0 SimpleCalc_Add
HSTORE TEMP 3 4 SimpleCalc_Multiply
MOVE TEMP 5 4
L2	CJUMP LE TEMP 5 3 L3
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L2
L3 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 5 10 )

PRINT TEMP 1

MOVE TEMP 1 CALL BEGIN
MOVE TEMP 8 BEGIN
MOVE TEMP 9 HALLOCATE 8
MOVE TEMP 10 HALLOCATE 4
HSTORE TEMP 9 0 SimpleCalc_Add
HSTORE TEMP 9 4 SimpleCalc_Multiply
MOVE TEMP 11 4
L4	CJUMP LE TEMP 11 3 L5
HSTORE PLUS TEMP 10 TEMP 11 0 0
MOVE TEMP 11 PLUS TEMP 11 4
JUMP L4
L5 HSTORE TEMP 10 0 TEMP 9
RETURN TEMP 10
END

HLOAD TEMP 12 TEMP 8 0
HLOAD TEMP 13 TEMP 12 4
RETURN TEMP 13
END ( TEMP 8 3 7 )

PRINT TEMP 1

RETURN 0
END

SimpleCalc_Add [ 3 ]
BEGIN

RETURN PLUS TEMP 1 TEMP 2
END

SimpleCalc_Multiply [ 3 ]
BEGIN

RETURN TIMES TEMP 1 TEMP 2
END

