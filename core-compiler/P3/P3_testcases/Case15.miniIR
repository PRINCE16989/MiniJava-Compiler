MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 4
MOVE TEMP 4 HALLOCATE 8
HSTORE TEMP 3 0 ArrayFieldTest_TestField
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 7 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

ArrayFieldTest_TestField [ 1 ]
BEGIN

HSTORE TEMP 0 4 BEGIN
MOVE TEMP 4 HALLOCATE  TIMES  PLUS 4 1  4
MOVE TEMP 5 4
L2 CJUMP  LE TEMP 5 MINUS  TIMES  PLUS 4 1  4  1 L3
HSTORE  PLUS TEMP 4 TEMP 5 0  0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L2
L3 HSTORE TEMP 4 0 4
RETURN TEMP 4
END


HSTORE PLUS BEGIN
HLOAD TEMP 6 TEMP 0 4
RETURN TEMP 6
END
 TIMES 4 0 4 5

HSTORE PLUS BEGIN
HLOAD TEMP 7 TEMP 0 4
RETURN TEMP 7
END
 TIMES 4 1 4 10

HSTORE PLUS BEGIN
HLOAD TEMP 8 TEMP 0 4
RETURN TEMP 8
END
 TIMES 4 2 4 15

HSTORE PLUS BEGIN
HLOAD TEMP 9 TEMP 0 4
RETURN TEMP 9
END
 TIMES 4 3 4 20

MOVE TEMP 2 BEGIN
MOVE TEMP 11 PLUS BEGIN
HLOAD TEMP 10 TEMP 0 4
RETURN TEMP 10
END
 TIMES 4 0
HLOAD TEMP 12 TEMP 11 4
RETURN TEMP 12
END


MOVE TEMP 3 BEGIN
MOVE TEMP 14 PLUS BEGIN
HLOAD TEMP 13 TEMP 0 4
RETURN TEMP 13
END
 TIMES 4 3
HLOAD TEMP 15 TEMP 14 4
RETURN TEMP 15
END


MOVE TEMP 1 PLUS TEMP 2 TEMP 3

PRINT TEMP 1

MOVE TEMP 2 BEGIN
MOVE TEMP 17 PLUS BEGIN
HLOAD TEMP 16 TEMP 0 4
RETURN TEMP 16
END
 TIMES 4 1
HLOAD TEMP 18 TEMP 17 4
RETURN TEMP 18
END


MOVE TEMP 3 BEGIN
MOVE TEMP 20 PLUS BEGIN
HLOAD TEMP 19 TEMP 0 4
RETURN TEMP 19
END
 TIMES 4 2
HLOAD TEMP 21 TEMP 20 4
RETURN TEMP 21
END


MOVE TEMP 1 PLUS TEMP 2 TEMP 3

PRINT TEMP 1

RETURN 0
END

