MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 16
MOVE TEMP 4 HALLOCATE 12
HSTORE TEMP 3 0 BBS_Start
HSTORE TEMP 3 4 BBS_Sort
HSTORE TEMP 3 8 BBS_Print
HSTORE TEMP 3 12 BBS_Init
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 11 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 10 )
END

BBS_Start [ 2 ]
BEGIN

MOVE TEMP 2 CALL BEGIN
MOVE TEMP 3 TEMP 0
HLOAD TEMP 4 TEMP 3 0
HLOAD TEMP 5 TEMP 4 12
RETURN TEMP 5
END ( TEMP 3 TEMP 1 )

MOVE TEMP 2 CALL BEGIN
MOVE TEMP 6 TEMP 0
HLOAD TEMP 7 TEMP 6 0
HLOAD TEMP 8 TEMP 7 8
RETURN TEMP 8
END ( TEMP 6 )

PRINT 99999

MOVE TEMP 2 CALL BEGIN
MOVE TEMP 9 TEMP 0
HLOAD TEMP 10 TEMP 9 0
HLOAD TEMP 11 TEMP 10 4
RETURN TEMP 11
END ( TEMP 9 )

MOVE TEMP 2 CALL BEGIN
MOVE TEMP 12 TEMP 0
HLOAD TEMP 13 TEMP 12 0
HLOAD TEMP 14 TEMP 13 8
RETURN TEMP 14
END ( TEMP 12 )

RETURN 0
END

BBS_Sort [ 1 ]
BEGIN

MOVE TEMP 2 MINUS BEGIN
HLOAD TEMP 10 TEMP 0 8
RETURN TEMP 10
END
 1

MOVE TEMP 3 MINUS 0 1
L2	CJUMP LE TEMP 3 MINUS TEMP 2 1 L4
CJUMP MINUS 1 LE TEMP 3 MINUS TEMP 2 1 L3

L3	
MOVE TEMP 8 1

L5	CJUMP LE TEMP 8 TEMP 2 L7
CJUMP MINUS 1 LE TEMP 8 TEMP 2 L6

L6	
MOVE TEMP 7 MINUS TEMP 8 1


MOVE TEMP 4 BEGIN
MOVE TEMP 12 PLUS BEGIN
HLOAD TEMP 11 TEMP 0 4
RETURN TEMP 11
END
 TIMES 4 TEMP 7
HLOAD TEMP 13 TEMP 12 4
RETURN TEMP 13
END



MOVE TEMP 5 BEGIN
MOVE TEMP 15 PLUS BEGIN
HLOAD TEMP 14 TEMP 0 4
RETURN TEMP 14
END
 TIMES 4 TEMP 8
HLOAD TEMP 16 TEMP 15 4
RETURN TEMP 16
END


CJUMP LE TEMP 5 MINUS TEMP 4 1 L9
CJUMP MINUS 1 LE TEMP 5 MINUS TEMP 4 1 L8
 
L8 
MOVE TEMP 6 MINUS TEMP 8 1


MOVE TEMP 9 BEGIN
MOVE TEMP 18 PLUS BEGIN
HLOAD TEMP 17 TEMP 0 4
RETURN TEMP 17
END
 TIMES 4 TEMP 6
HLOAD TEMP 19 TEMP 18 4
RETURN TEMP 19
END



HSTORE PLUS BEGIN
HLOAD TEMP 20 TEMP 0 4
RETURN TEMP 20
END
 TIMES 4 TEMP 6 4 BEGIN
MOVE TEMP 22 PLUS BEGIN
HLOAD TEMP 21 TEMP 0 4
RETURN TEMP 21
END
 TIMES 4 TEMP 8
HLOAD TEMP 23 TEMP 22 4
RETURN TEMP 23
END



HSTORE PLUS BEGIN
HLOAD TEMP 24 TEMP 0 4
RETURN TEMP 24
END
 TIMES 4 TEMP 8 4 TEMP 9

 JUMP L10
L9 
MOVE TEMP 1 0

L10 NOOP


MOVE TEMP 8 PLUS TEMP 8 1


JUMP L5
L7	NOOP


MOVE TEMP 2 MINUS TEMP 2 1


JUMP L2
L4	NOOP

RETURN 0
END

BBS_Print [ 1 ]
BEGIN

MOVE TEMP 1 0
L11	CJUMP LE TEMP 1 MINUS BEGIN
HLOAD TEMP 2 TEMP 0 8
RETURN TEMP 2
END
 1 L13
CJUMP MINUS 1 LE TEMP 1 MINUS BEGIN
HLOAD TEMP 2 TEMP 0 8
RETURN TEMP 2
END
 1 L12

L12	
PRINT BEGIN
MOVE TEMP 4 PLUS BEGIN
HLOAD TEMP 3 TEMP 0 4
RETURN TEMP 3
END
 TIMES 4 TEMP 1
HLOAD TEMP 5 TEMP 4 4
RETURN TEMP 5
END



MOVE TEMP 1 PLUS TEMP 1 1


JUMP L11
L13	NOOP

RETURN 0
END

BBS_Init [ 2 ]
BEGIN

HSTORE TEMP 0 8 TEMP 1

HSTORE TEMP 0 4 BEGIN
MOVE TEMP 2 HALLOCATE  TIMES  PLUS TEMP 1 1  4
MOVE TEMP 3 4
L14 CJUMP  LE TEMP 3 MINUS  TIMES  PLUS TEMP 1 1  4  1 L15
HSTORE  PLUS TEMP 2 TEMP 3 0  0
MOVE TEMP 3 PLUS TEMP 3 4
JUMP L14
L15 HSTORE TEMP 2 0 TEMP 1
RETURN TEMP 2
END


HSTORE PLUS BEGIN
HLOAD TEMP 4 TEMP 0 4
RETURN TEMP 4
END
 TIMES 4 0 4 20

HSTORE PLUS BEGIN
HLOAD TEMP 5 TEMP 0 4
RETURN TEMP 5
END
 TIMES 4 1 4 7

HSTORE PLUS BEGIN
HLOAD TEMP 6 TEMP 0 4
RETURN TEMP 6
END
 TIMES 4 2 4 12

HSTORE PLUS BEGIN
HLOAD TEMP 7 TEMP 0 4
RETURN TEMP 7
END
 TIMES 4 3 4 18

HSTORE PLUS BEGIN
HLOAD TEMP 8 TEMP 0 4
RETURN TEMP 8
END
 TIMES 4 4 4 2

HSTORE PLUS BEGIN
HLOAD TEMP 9 TEMP 0 4
RETURN TEMP 9
END
 TIMES 4 5 4 11

HSTORE PLUS BEGIN
HLOAD TEMP 10 TEMP 0 4
RETURN TEMP 10
END
 TIMES 4 6 4 6

HSTORE PLUS BEGIN
HLOAD TEMP 11 TEMP 0 4
RETURN TEMP 11
END
 TIMES 4 7 4 9

HSTORE PLUS BEGIN
HLOAD TEMP 12 TEMP 0 4
RETURN TEMP 12
END
 TIMES 4 8 4 19

HSTORE PLUS BEGIN
HLOAD TEMP 13 TEMP 0 4
RETURN TEMP 13
END
 TIMES 4 9 4 5

RETURN 0
END

