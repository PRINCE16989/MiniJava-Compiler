MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 4
MOVE TEMP 4 HALLOCATE 8
HSTORE TEMP 3 0 LambdaFieldTest_TestLambdaField
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 7 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

LambdaFieldTest_TestLambdaField [ 1 ]
BEGIN

HSTORE TEMP 0 4 BEGIN
MOVE TEMP 4 HALLOCATE 4
MOVE TEMP 5 HALLOCATE 4
HSTORE TEMP 4 0 lambda_func0
 HSTORE TEMP 5 0 TEMP 4
RETURN TEMP 5
END


MOVE TEMP 2 BEGIN
MOVE TEMP 6 HALLOCATE 4
MOVE TEMP 7 HALLOCATE 4
HSTORE TEMP 6 0 Item_Process
MOVE TEMP 8 4
L2	CJUMP LE TEMP 8 3 L3
HSTORE PLUS TEMP 7 TEMP 8 0 0
MOVE TEMP 8 PLUS TEMP 8 4
JUMP L2
L3 HSTORE TEMP 7 0 TEMP 6
RETURN TEMP 7
END


MOVE TEMP 3 CALL BEGIN
MOVE TEMP 9 TEMP 2
HLOAD TEMP 10 TEMP 9 0
HLOAD TEMP 11 TEMP 10 0
RETURN TEMP 11
END ( TEMP 9 100 )

PRINT TEMP 3

MOVE TEMP 2 CALL BEGIN
MOVE TEMP 12 BEGIN
HLOAD TEMP 13 TEMP 0 4
RETURN TEMP 13
END

HLOAD TEMP 14 TEMP 12 0
HLOAD TEMP 15 TEMP 14 0
RETURN TEMP 15
END ( TEMP 12 TEMP 2 )

MOVE TEMP 3 CALL BEGIN
MOVE TEMP 16 TEMP 2
HLOAD TEMP 17 TEMP 16 0
HLOAD TEMP 18 TEMP 17 0
RETURN TEMP 18
END ( TEMP 16 101 )

PRINT TEMP 3

RETURN 0
END

Item_Process [ 2 ]
BEGIN

RETURN PLUS TEMP 1 50
END

lambda_func0 [2]
BEGIN 
RETURN TEMP 1
END

