MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 4
MOVE TEMP 4 HALLOCATE 12
HSTORE TEMP 3 0 FieldTest_UseFields
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 11 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

FieldTest_UseFields [ 1 ]
BEGIN

HSTORE TEMP 0 4 10

HSTORE TEMP 0 8 20

PRINT BEGIN
HLOAD TEMP 1 TEMP 0 4
RETURN TEMP 1
END


PRINT BEGIN
HLOAD TEMP 2 TEMP 0 8
RETURN TEMP 2
END


PRINT PLUS BEGIN
HLOAD TEMP 3 TEMP 0 4
RETURN TEMP 3
END
 BEGIN
HLOAD TEMP 4 TEMP 0 8
RETURN TEMP 4
END


RETURN 0
END

