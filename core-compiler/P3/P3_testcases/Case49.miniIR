MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 4
MOVE TEMP 4 HALLOCATE 4
HSTORE TEMP 3 0 FieldArg_TestFieldArg
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 3 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

FieldArg_TestFieldArg [ 1 ]
BEGIN

MOVE TEMP 2 BEGIN
MOVE TEMP 6 HALLOCATE 12
MOVE TEMP 7 HALLOCATE 12
HSTORE TEMP 6 0 Data_Initialize
HSTORE TEMP 6 4 Data_GetX
HSTORE TEMP 6 8 Data_GetY
MOVE TEMP 8 4
L2	CJUMP LE TEMP 8 11 L3
HSTORE PLUS TEMP 7 TEMP 8 0 0
MOVE TEMP 8 PLUS TEMP 8 4
JUMP L2
L3 HSTORE TEMP 7 0 TEMP 6
RETURN TEMP 7
END


MOVE TEMP 4 BEGIN
MOVE TEMP 9 HALLOCATE 4
MOVE TEMP 10 HALLOCATE 4
HSTORE TEMP 9 0 Processor_ProcessData
MOVE TEMP 11 4
L4	CJUMP LE TEMP 11 3 L5
HSTORE PLUS TEMP 10 TEMP 11 0 0
MOVE TEMP 11 PLUS TEMP 11 4
JUMP L4
L5 HSTORE TEMP 10 0 TEMP 9
RETURN TEMP 10
END


MOVE TEMP 5 CALL BEGIN
MOVE TEMP 12 TEMP 2
HLOAD TEMP 13 TEMP 12 0
HLOAD TEMP 14 TEMP 13 0
RETURN TEMP 14
END ( TEMP 12 100 200 )

MOVE TEMP 5 CALL BEGIN
MOVE TEMP 15 TEMP 4
HLOAD TEMP 16 TEMP 15 0
HLOAD TEMP 17 TEMP 16 0
RETURN TEMP 17
END ( TEMP 15 CALL BEGIN
MOVE TEMP 18 TEMP 2
HLOAD TEMP 19 TEMP 18 0
HLOAD TEMP 20 TEMP 19 4
RETURN TEMP 20
END ( TEMP 18 ) CALL BEGIN
MOVE TEMP 21 TEMP 2
HLOAD TEMP 22 TEMP 21 0
HLOAD TEMP 23 TEMP 22 8
RETURN TEMP 23
END ( TEMP 21 ) )

PRINT TEMP 5

RETURN 0
END

Data_Initialize [ 3 ]
BEGIN

HSTORE TEMP 0 4 TEMP 1

HSTORE TEMP 0 8 TEMP 2

RETURN 0
END

Data_GetX [ 1 ]
BEGIN

RETURN BEGIN
HLOAD TEMP 1 TEMP 0 4
RETURN TEMP 1
END

END

Data_GetY [ 1 ]
BEGIN

RETURN BEGIN
HLOAD TEMP 1 TEMP 0 8
RETURN TEMP 1
END

END

Processor_ProcessData [ 3 ]
BEGIN

RETURN PLUS TEMP 1 TEMP 2
END

