MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 4
MOVE TEMP 4 HALLOCATE 12
HSTORE TEMP 3 0 BoolFieldTest_TestBoolField
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 11 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

BoolFieldTest_TestBoolField [ 1 ]
BEGIN

HSTORE TEMP 0 4 1

HSTORE TEMP 0 8 0
CJUMP BEGIN
HLOAD TEMP 2 TEMP 0 4
RETURN TEMP 2
END
 L3
CJUMP MINUS 1 BEGIN
HLOAD TEMP 2 TEMP 0 4
RETURN TEMP 2
END
 L2
 
L2 
HSTORE TEMP 0 8 100

 JUMP L4
L3 
HSTORE TEMP 0 8 200


L4 NOOP

PRINT BEGIN
HLOAD TEMP 3 TEMP 0 8
RETURN TEMP 3
END


HSTORE TEMP 0 4 0
CJUMP BEGIN
HLOAD TEMP 4 TEMP 0 4
RETURN TEMP 4
END
 L6
CJUMP MINUS 1 BEGIN
HLOAD TEMP 4 TEMP 0 4
RETURN TEMP 4
END
 L5
 
L5 
HSTORE TEMP 0 8 300

 JUMP L7
L6 
HSTORE TEMP 0 8 400


L7 NOOP

PRINT BEGIN
HLOAD TEMP 5 TEMP 0 8
RETURN TEMP 5
END


RETURN 0
END

