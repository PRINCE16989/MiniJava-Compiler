END


MOVE TEMP 3 CALL BEGIN
MOVE TEMP 25 TEMP 2
HLOAD TEMP 26 TEMP 25 0
HLOAD TEMP 27 TEMP 26 4
RETURN TEMP 27
END ( TEMP 25 5 6 )

PRINT TEMP 3

RETURN 0
END

