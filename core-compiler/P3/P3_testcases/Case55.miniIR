MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 8
MOVE TEMP 4 HALLOCATE 4
HSTORE TEMP 3 0 A_foo
HSTORE TEMP 3 4 A_bar
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 3 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 2 )
END

A_foo [ 2 ]
BEGIN

MOVE TEMP 8 BEGIN
MOVE TEMP 9 HALLOCATE 12
MOVE TEMP 10 HALLOCATE 8
HSTORE TEMP 9 0 B_setf2
HSTORE TEMP 9 4 B_getf2
HSTORE TEMP 9 8 B_getLambda
MOVE TEMP 11 4
L2	CJUMP LE TEMP 11 7 L3
HSTORE PLUS TEMP 10 TEMP 11 0 0
MOVE TEMP 11 PLUS TEMP 11 4
JUMP L2
L3 HSTORE TEMP 10 0 TEMP 9
RETURN TEMP 10
END


MOVE TEMP 2 CALL BEGIN
MOVE TEMP 12 TEMP 8
HLOAD TEMP 13 TEMP 12 0
HLOAD TEMP 14 TEMP 13 0
RETURN TEMP 14
END ( TEMP 12 50 )

MOVE TEMP 4 BEGIN
MOVE TEMP 25 HALLOCATE 4
MOVE TEMP 26 HALLOCATE 8
HSTORE TEMP 25 0 lambda_func0
HSTORE PLUS TEMP 26 4 0 TEMP 8
 HSTORE TEMP 26 0 TEMP 25
RETURN TEMP 26
END


MOVE TEMP 6 CALL BEGIN
MOVE TEMP 27 TEMP 8
HLOAD TEMP 28 TEMP 27 0
HLOAD TEMP 29 TEMP 28 8
RETURN TEMP 29
END ( TEMP 27 TEMP 4 )

MOVE TEMP 2 CALL BEGIN
MOVE TEMP 30 TEMP 6
HLOAD TEMP 31 TEMP 30 0
HLOAD TEMP 32 TEMP 31 0
RETURN TEMP 32
END ( TEMP 30 1 )

RETURN TEMP 2
END

A_bar [ 2 ]
BEGIN
CJUMP TEMP 1 L7
CJUMP MINUS 1 TEMP 1 L6
 
L6 
MOVE TEMP 2 1
 JUMP L8
L7 
MOVE TEMP 2 10

L8 NOOP

RETURN TEMP 2
END

B_setf2 [ 2 ]
BEGIN

HSTORE TEMP 0 4 TEMP 1

RETURN 0
END

B_getf2 [ 1 ]
BEGIN

RETURN BEGIN
HLOAD TEMP 1 TEMP 0 4
RETURN TEMP 1
END

END

B_getLambda [ 2 ]
BEGIN

MOVE TEMP 2 3

MOVE TEMP 3 BEGIN
MOVE TEMP 9 HALLOCATE 4
MOVE TEMP 10 HALLOCATE 12
HSTORE TEMP 9 0 lambda_func1
HSTORE PLUS TEMP 10 4 0 TEMP 2
HSTORE PLUS TEMP 10 8 0 TEMP 1
 HSTORE TEMP 10 0 TEMP 9
RETURN TEMP 10
END


RETURN TEMP 3
END

lambda_func0 [2]
BEGIN 
RETURN PLUS PLUS CALL BEGIN
MOVE TEMP 15 BEGIN
MOVE TEMP 16 HALLOCATE 8
MOVE TEMP 17 HALLOCATE 4
HSTORE TEMP 16 0 A_foo
HSTORE TEMP 16 4 A_bar
MOVE TEMP 18 4
L4	CJUMP LE TEMP 18 3 L5
HSTORE PLUS TEMP 17 TEMP 18 0 0
MOVE TEMP 18 PLUS TEMP 18 4
JUMP L4
L5 HSTORE TEMP 17 0 TEMP 16
RETURN TEMP 17
END

HLOAD TEMP 19 TEMP 15 0
HLOAD TEMP 20 TEMP 19 4
RETURN TEMP 20
END ( TEMP 15 1 ) CALL BEGIN
MOVE TEMP 21 BEGIN
HLOAD TEMP 22 TEMP 0 4
RETURN TEMP 22
END

HLOAD TEMP 23 TEMP 21 0
HLOAD TEMP 24 TEMP 23 4
RETURN TEMP 24
END ( TEMP 21 ) TEMP 1
END

lambda_func1 [2]
BEGIN 
RETURN PLUS BEGIN
HLOAD TEMP 4 TEMP 0 4
RETURN TEMP 4
END
 CALL BEGIN
MOVE TEMP 5 BEGIN
HLOAD TEMP 6 TEMP 0 8
RETURN TEMP 6
END

HLOAD TEMP 7 TEMP 5 0
HLOAD TEMP 8 TEMP 7 0
RETURN TEMP 8
END ( TEMP 5 50 )
END

