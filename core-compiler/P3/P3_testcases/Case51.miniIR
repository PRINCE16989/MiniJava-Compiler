MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 4
MOVE TEMP 4 HALLOCATE 4
HSTORE TEMP 3 0 LambdaTest_TestLambda
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 3 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

LambdaTest_TestLambda [ 1 ]
BEGIN

MOVE TEMP 2 BEGIN
MOVE TEMP 5 HALLOCATE 4
MOVE TEMP 6 HALLOCATE 4
HSTORE TEMP 5 0 lambda_func0
 HSTORE TEMP 6 0 TEMP 5
RETURN TEMP 6
END


MOVE TEMP 4 CALL BEGIN
MOVE TEMP 7 TEMP 2
HLOAD TEMP 8 TEMP 7 0
HLOAD TEMP 9 TEMP 8 0
RETURN TEMP 9
END ( TEMP 7 10 )

PRINT TEMP 4

MOVE TEMP 3 BEGIN
MOVE TEMP 10 HALLOCATE 4
MOVE TEMP 11 HALLOCATE 4
HSTORE TEMP 10 0 lambda_func1
 HSTORE TEMP 11 0 TEMP 10
RETURN TEMP 11
END


MOVE TEMP 4 CALL BEGIN
MOVE TEMP 12 TEMP 3
HLOAD TEMP 13 TEMP 12 0
HLOAD TEMP 14 TEMP 13 0
RETURN TEMP 14
END ( TEMP 12 10 )

PRINT TEMP 4

MOVE TEMP 3 TEMP 2

MOVE TEMP 4 CALL BEGIN
MOVE TEMP 15 TEMP 3
HLOAD TEMP 16 TEMP 15 0
HLOAD TEMP 17 TEMP 16 0
RETURN TEMP 17
END ( TEMP 15 TEMP 4 )

PRINT TEMP 4

RETURN 0
END

lambda_func0 [2]
BEGIN 
RETURN TIMES TEMP 1 2
END

lambda_func1 [2]
BEGIN 
RETURN TIMES TEMP 1 4
END

