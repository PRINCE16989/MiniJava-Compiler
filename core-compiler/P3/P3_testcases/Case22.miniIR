MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 4
MOVE TEMP 4 HALLOCATE 4
HSTORE TEMP 3 0 ExprArgTest_TestExprArgs
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 3 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

ExprArgTest_TestExprArgs [ 1 ]
BEGIN

MOVE TEMP 2 BEGIN
MOVE TEMP 4 HALLOCATE 8
MOVE TEMP 5 HALLOCATE 4
HSTORE TEMP 4 0 Processor_Process
HSTORE TEMP 4 4 Processor_Add
MOVE TEMP 6 4
L2	CJUMP LE TEMP 6 3 L3
HSTORE PLUS TEMP 5 TEMP 6 0 0
MOVE TEMP 6 PLUS TEMP 6 4
JUMP L2
L3 HSTORE TEMP 5 0 TEMP 4
RETURN TEMP 5
END


MOVE TEMP 3 CALL BEGIN
MOVE TEMP 7 TEMP 2
HLOAD TEMP 8 TEMP 7 0
HLOAD TEMP 9 TEMP 8 0
RETURN TEMP 9
END ( TEMP 7 PLUS 5 3 )

PRINT TEMP 3

MOVE TEMP 3 CALL BEGIN
MOVE TEMP 10 TEMP 2
HLOAD TEMP 11 TEMP 10 0
HLOAD TEMP 12 TEMP 11 0
RETURN TEMP 12
END ( TEMP 10 TIMES 10 2 )

PRINT TEMP 3

MOVE TEMP 3 CALL BEGIN
MOVE TEMP 13 TEMP 2
HLOAD TEMP 14 TEMP 13 0
HLOAD TEMP 15 TEMP 14 4
RETURN TEMP 15
END ( TEMP 13 PLUS 3 2 TIMES 4 2 )

PRINT TEMP 3

RETURN 0
END

Processor_Process [ 2 ]
BEGIN

RETURN PLUS TEMP 1 100
END

Processor_Add [ 3 ]
BEGIN

RETURN PLUS TEMP 1 TEMP 2
END

