MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 4
MOVE TEMP 4 HALLOCATE 4
HSTORE TEMP 3 0 BoolTest_TestBool
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 3 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

BoolTest_TestBool [ 1 ]
BEGIN

MOVE TEMP 1 1

MOVE TEMP 2 0
CJUMP TEMP 1 L3
CJUMP MINUS 1 TEMP 1 L2
 
L2 
PRINT 1

 JUMP L4
L3 
PRINT 0


L4 NOOP
CJUMP TEMP 2 L6
CJUMP MINUS 1 TEMP 2 L5
 
L5 
PRINT 1

 JUMP L7
L6 
PRINT 0


L7 NOOP
CJUMP LE 5 10 L9
CJUMP MINUS 1 LE 5 10 L8
 
L8 
MOVE TEMP 3 1

 JUMP L10
L9 
MOVE TEMP 3 0


L10 NOOP

PRINT TEMP 3
CJUMP NE 10 5 L12
CJUMP MINUS 1 NE 10 5 L11
 
L11 
MOVE TEMP 3 1

 JUMP L13
L12 
MOVE TEMP 3 0


L13 NOOP

PRINT TEMP 3

RETURN 0
END

