MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 4
MOVE TEMP 4 HALLOCATE 4
HSTORE TEMP 3 0 InheritTest_TestInherit
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 3 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

InheritTest_TestInherit [ 1 ]
BEGIN

MOVE TEMP 2 BEGIN
MOVE TEMP 7 HALLOCATE 4
MOVE TEMP 8 HALLOCATE 4
HSTORE TEMP 7 0 Parent_Compute
MOVE TEMP 9 4
L2	CJUMP LE TEMP 9 3 L3
HSTORE PLUS TEMP 8 TEMP 9 0 0
MOVE TEMP 9 PLUS TEMP 9 4
JUMP L2
L3 HSTORE TEMP 8 0 TEMP 7
RETURN TEMP 8
END


MOVE TEMP 4 BEGIN
MOVE TEMP 10 HALLOCATE 4
MOVE TEMP 11 HALLOCATE 4
HSTORE TEMP 10 0 Child_Compute
MOVE TEMP 12 4
L4	CJUMP LE TEMP 12 3 L5
HSTORE PLUS TEMP 11 TEMP 12 0 0
MOVE TEMP 12 PLUS TEMP 12 4
JUMP L4
L5 HSTORE TEMP 11 0 TEMP 10
RETURN TEMP 11
END


MOVE TEMP 5 CALL BEGIN
MOVE TEMP 13 TEMP 2
HLOAD TEMP 14 TEMP 13 0
HLOAD TEMP 15 TEMP 14 0
RETURN TEMP 15
END ( TEMP 13 10 )

PRINT TEMP 5

MOVE TEMP 6 CALL BEGIN
MOVE TEMP 16 TEMP 4
HLOAD TEMP 17 TEMP 16 0
HLOAD TEMP 18 TEMP 17 0
RETURN TEMP 18
END ( TEMP 16 10 )

PRINT TEMP 6

RETURN 0
END

Parent_Compute [ 2 ]
BEGIN

RETURN PLUS TEMP 1 5
END

Child_Compute [ 2 ]
BEGIN

RETURN TIMES TEMP 1 2
END

