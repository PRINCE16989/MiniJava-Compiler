MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 4
MOVE TEMP 4 HALLOCATE 4
HSTORE TEMP 3 0 InheritFieldTest_TestInheritFields
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 3 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

InheritFieldTest_TestInheritFields [ 1 ]
BEGIN

MOVE TEMP 2 BEGIN
MOVE TEMP 4 HALLOCATE 8
MOVE TEMP 5 HALLOCATE 8
HSTORE TEMP 4 0 Parent_SetData
HSTORE TEMP 4 4 Child_UseParentField
MOVE TEMP 6 4
L2	CJUMP LE TEMP 6 7 L3
HSTORE PLUS TEMP 5 TEMP 6 0 0
MOVE TEMP 6 PLUS TEMP 6 4
JUMP L2
L3 HSTORE TEMP 5 0 TEMP 4
RETURN TEMP 5
END


MOVE TEMP 3 CALL BEGIN
MOVE TEMP 7 TEMP 2
HLOAD TEMP 8 TEMP 7 0
HLOAD TEMP 9 TEMP 8 4
RETURN TEMP 9
END ( TEMP 7 )

PRINT TEMP 3

RETURN 0
END

Parent_SetData [ 2 ]
BEGIN

HSTORE TEMP 0 4 TEMP 1

RETURN BEGIN
HLOAD TEMP 2 TEMP 0 4
RETURN TEMP 2
END

END

Child_UseParentField [ 1 ]
BEGIN

HSTORE TEMP 0 4 55

MOVE TEMP 1 PLUS BEGIN
HLOAD TEMP 2 TEMP 0 4
RETURN TEMP 2
END
 45

PRINT BEGIN
HLOAD TEMP 3 TEMP 0 4
RETURN TEMP 3
END


PRINT TEMP 1

RETURN TEMP 1
END

