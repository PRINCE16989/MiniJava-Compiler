MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 4
MOVE TEMP 4 HALLOCATE 4
HSTORE TEMP 3 0 ArrayObjTest_TestArrayObj
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 3 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

ArrayObjTest_TestArrayObj [ 1 ]
BEGIN

MOVE TEMP 2 BEGIN
MOVE TEMP 4 HALLOCATE 8
MOVE TEMP 5 HALLOCATE 8
HSTORE TEMP 4 0 Container_Init
HSTORE TEMP 4 4 Container_ProcessArray
MOVE TEMP 6 4
L2	CJUMP LE TEMP 6 7 L3
HSTORE PLUS TEMP 5 TEMP 6 0 0
MOVE TEMP 6 PLUS TEMP 6 4
JUMP L2
L3 HSTORE TEMP 5 0 TEMP 4
RETURN TEMP 5
END


MOVE TEMP 3 CALL BEGIN
MOVE TEMP 7 TEMP 2
HLOAD TEMP 8 TEMP 7 0
HLOAD TEMP 9 TEMP 8 0
RETURN TEMP 9
END ( TEMP 7 )

MOVE TEMP 3 CALL BEGIN
MOVE TEMP 10 TEMP 2
HLOAD TEMP 11 TEMP 10 0
HLOAD TEMP 12 TEMP 11 4
RETURN TEMP 12
END ( TEMP 10 )

RETURN 0
END

Container_Init [ 1 ]
BEGIN

HSTORE TEMP 0 4 BEGIN
MOVE TEMP 1 HALLOCATE  TIMES  PLUS 3 1  4
MOVE TEMP 2 4
L4 CJUMP  LE TEMP 2 MINUS  TIMES  PLUS 3 1  4  1 L5
HSTORE  PLUS TEMP 1 TEMP 2 0  0
MOVE TEMP 2 PLUS TEMP 2 4
JUMP L4
L5 HSTORE TEMP 1 0 3
RETURN TEMP 1
END


HSTORE PLUS BEGIN
HLOAD TEMP 3 TEMP 0 4
RETURN TEMP 3
END
 TIMES 4 0 4 10

HSTORE PLUS BEGIN
HLOAD TEMP 4 TEMP 0 4
RETURN TEMP 4
END
 TIMES 4 1 4 20

HSTORE PLUS BEGIN
HLOAD TEMP 5 TEMP 0 4
RETURN TEMP 5
END
 TIMES 4 2 4 30

RETURN 0
END

Container_ProcessArray [ 1 ]
BEGIN

MOVE TEMP 1 0

MOVE TEMP 2 0
L6	CJUMP LE TEMP 1 2 L8
CJUMP MINUS 1 LE TEMP 1 2 L7

L7	
MOVE TEMP 3 BEGIN
MOVE TEMP 5 PLUS BEGIN
HLOAD TEMP 4 TEMP 0 4
RETURN TEMP 4
END
 TIMES 4 TEMP 1
HLOAD TEMP 6 TEMP 5 4
RETURN TEMP 6
END



MOVE TEMP 2 PLUS TEMP 2 TEMP 3


PRINT TEMP 2


MOVE TEMP 1 PLUS TEMP 1 1


JUMP L6
L8	NOOP

RETURN TEMP 2
END

