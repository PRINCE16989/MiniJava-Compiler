MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 4
MOVE TEMP 4 HALLOCATE 4
HSTORE TEMP 3 0 ChainTest_TestChain
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 3 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

ChainTest_TestChain [ 1 ]
BEGIN

MOVE TEMP 2 BEGIN
MOVE TEMP 6 HALLOCATE 4
MOVE TEMP 7 HALLOCATE 4
HSTORE TEMP 6 0 Builder_GetWorker
MOVE TEMP 8 4
L2	CJUMP LE TEMP 8 3 L3
HSTORE PLUS TEMP 7 TEMP 8 0 0
MOVE TEMP 8 PLUS TEMP 8 4
JUMP L2
L3 HSTORE TEMP 7 0 TEMP 6
RETURN TEMP 7
END


MOVE TEMP 4 CALL BEGIN
MOVE TEMP 9 TEMP 2
HLOAD TEMP 10 TEMP 9 0
HLOAD TEMP 11 TEMP 10 0
RETURN TEMP 11
END ( TEMP 9 )

MOVE TEMP 5 CALL BEGIN
MOVE TEMP 12 TEMP 4
HLOAD TEMP 13 TEMP 12 0
HLOAD TEMP 14 TEMP 13 0
RETURN TEMP 14
END ( TEMP 12 15 )

PRINT TEMP 5

RETURN 0
END

Builder_GetWorker [ 1 ]
BEGIN

MOVE TEMP 1 BEGIN
MOVE TEMP 2 HALLOCATE 4
MOVE TEMP 3 HALLOCATE 4
HSTORE TEMP 2 0 Worker_DoWork
MOVE TEMP 4 4
L4	CJUMP LE TEMP 4 3 L5
HSTORE PLUS TEMP 3 TEMP 4 0 0
MOVE TEMP 4 PLUS TEMP 4 4
JUMP L4
L5 HSTORE TEMP 3 0 TEMP 2
RETURN TEMP 3
END


RETURN TEMP 1
END

Worker_DoWork [ 2 ]
BEGIN

RETURN TIMES TEMP 1 2
END

