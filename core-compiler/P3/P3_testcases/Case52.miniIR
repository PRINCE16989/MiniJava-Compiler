MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 4
MOVE TEMP 4 HALLOCATE 8
HSTORE TEMP 3 0 LambdaFieldTest_TestLambdaField
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 7 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

LambdaFieldTest_TestLambdaField [ 1 ]
BEGIN

HSTORE TEMP 0 4 BEGIN
MOVE TEMP 7 HALLOCATE 4
MOVE TEMP 8 HALLOCATE 4
HSTORE TEMP 7 0 lambda_func0
 HSTORE TEMP 8 0 TEMP 7
RETURN TEMP 8
END


MOVE TEMP 2 BEGIN
MOVE TEMP 9 HALLOCATE 8
MOVE TEMP 10 HALLOCATE 8
HSTORE TEMP 9 0 Item_Process
HSTORE TEMP 9 4 Item_setf
MOVE TEMP 11 4
L4	CJUMP LE TEMP 11 7 L5
HSTORE PLUS TEMP 10 TEMP 11 0 0
MOVE TEMP 11 PLUS TEMP 11 4
JUMP L4
L5 HSTORE TEMP 10 0 TEMP 9
RETURN TEMP 10
END


MOVE TEMP 3 CALL BEGIN
MOVE TEMP 12 TEMP 2
HLOAD TEMP 13 TEMP 12 0
HLOAD TEMP 14 TEMP 13 4
RETURN TEMP 14
END ( TEMP 12 50 )

MOVE TEMP 3 CALL BEGIN
MOVE TEMP 15 TEMP 2
HLOAD TEMP 16 TEMP 15 0
HLOAD TEMP 17 TEMP 16 0
RETURN TEMP 17
END ( TEMP 15 100 )

PRINT TEMP 3

MOVE TEMP 2 CALL BEGIN
MOVE TEMP 18 BEGIN
HLOAD TEMP 19 TEMP 0 4
RETURN TEMP 19
END

HLOAD TEMP 20 TEMP 18 0
HLOAD TEMP 21 TEMP 20 0
RETURN TEMP 21
END ( TEMP 18 TEMP 2 )

MOVE TEMP 3 CALL BEGIN
MOVE TEMP 22 TEMP 2
HLOAD TEMP 23 TEMP 22 0
HLOAD TEMP 24 TEMP 23 0
RETURN TEMP 24
END ( TEMP 22 101 )

PRINT TEMP 3

RETURN 0
END

Item_Process [ 2 ]
BEGIN

RETURN PLUS TEMP 1 BEGIN
HLOAD TEMP 2 TEMP 0 4
RETURN TEMP 2
END

END

Item_setf [ 2 ]
BEGIN

HSTORE TEMP 0 4 TEMP 1

RETURN 0
END

lambda_func0 [2]
BEGIN 
RETURN BEGIN
MOVE TEMP 4 HALLOCATE 8
MOVE TEMP 5 HALLOCATE 8
HSTORE TEMP 4 0 Item_Process
HSTORE TEMP 4 4 Item_setf
MOVE TEMP 6 4
L2	CJUMP LE TEMP 6 7 L3
HSTORE PLUS TEMP 5 TEMP 6 0 0
MOVE TEMP 6 PLUS TEMP 6 4
JUMP L2
L3 HSTORE TEMP 5 0 TEMP 4
RETURN TEMP 5
END

END

