MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 4
MOVE TEMP 4 HALLOCATE 4
HSTORE TEMP 3 0 NestedObj_TestNested
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 3 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

NestedObj_TestNested [ 1 ]
BEGIN

MOVE TEMP 2 BEGIN
MOVE TEMP 8 HALLOCATE 4
MOVE TEMP 9 HALLOCATE 4
HSTORE TEMP 8 0 LevelOne_CreateLevel2
MOVE TEMP 10 4
L2	CJUMP LE TEMP 10 3 L3
HSTORE PLUS TEMP 9 TEMP 10 0 0
MOVE TEMP 10 PLUS TEMP 10 4
JUMP L2
L3 HSTORE TEMP 9 0 TEMP 8
RETURN TEMP 9
END


MOVE TEMP 4 CALL BEGIN
MOVE TEMP 11 TEMP 2
HLOAD TEMP 12 TEMP 11 0
HLOAD TEMP 13 TEMP 12 0
RETURN TEMP 13
END ( TEMP 11 )

MOVE TEMP 6 CALL BEGIN
MOVE TEMP 14 TEMP 4
HLOAD TEMP 15 TEMP 14 0
HLOAD TEMP 16 TEMP 15 0
RETURN TEMP 16
END ( TEMP 14 )

MOVE TEMP 7 CALL BEGIN
MOVE TEMP 17 TEMP 6
HLOAD TEMP 18 TEMP 17 0
HLOAD TEMP 19 TEMP 18 0
RETURN TEMP 19
END ( TEMP 17 )

PRINT TEMP 7

RETURN 0
END

LevelOne_CreateLevel2 [ 1 ]
BEGIN

MOVE TEMP 1 BEGIN
MOVE TEMP 2 HALLOCATE 4
MOVE TEMP 3 HALLOCATE 4
HSTORE TEMP 2 0 LevelTwo_CreateLevel3
MOVE TEMP 4 4
L4	CJUMP LE TEMP 4 3 L5
HSTORE PLUS TEMP 3 TEMP 4 0 0
MOVE TEMP 4 PLUS TEMP 4 4
JUMP L4
L5 HSTORE TEMP 3 0 TEMP 2
RETURN TEMP 3
END


RETURN TEMP 1
END

LevelTwo_CreateLevel3 [ 1 ]
BEGIN

MOVE TEMP 1 BEGIN
MOVE TEMP 2 HALLOCATE 4
MOVE TEMP 3 HALLOCATE 4
HSTORE TEMP 2 0 LevelThree_GetValue
MOVE TEMP 4 4
L6	CJUMP LE TEMP 4 3 L7
HSTORE PLUS TEMP 3 TEMP 4 0 0
MOVE TEMP 4 PLUS TEMP 4 4
JUMP L6
L7 HSTORE TEMP 3 0 TEMP 2
RETURN TEMP 3
END


RETURN TEMP 1
END

LevelThree_GetValue [ 1 ]
BEGIN

RETURN 999
END

