MAIN

PRINT CALL BEGIN
MOVE TEMP 2 BEGIN
MOVE TEMP 3 HALLOCATE 4
MOVE TEMP 4 HALLOCATE 4
HSTORE TEMP 3 0 ObjectParamTest_TestObjectParam
MOVE TEMP 5 4
L0	CJUMP LE TEMP 5 3 L1
HSTORE PLUS TEMP 4 TEMP 5 0 0
MOVE TEMP 5 PLUS TEMP 5 4
JUMP L0
L1 HSTORE TEMP 4 0 TEMP 3
RETURN TEMP 4
END

HLOAD TEMP 6 TEMP 2 0
HLOAD TEMP 7 TEMP 6 0
RETURN TEMP 7
END ( TEMP 2 )
END

ObjectParamTest_TestObjectParam [ 1 ]
BEGIN

MOVE TEMP 2 BEGIN
MOVE TEMP 6 HALLOCATE 12
MOVE TEMP 7 HALLOCATE 12
HSTORE TEMP 6 0 Point_SetCoords
HSTORE TEMP 6 4 Point_GetX
HSTORE TEMP 6 8 Point_GetY
MOVE TEMP 8 4
L2	CJUMP LE TEMP 8 11 L3
HSTORE PLUS TEMP 7 TEMP 8 0 0
MOVE TEMP 8 PLUS TEMP 8 4
JUMP L2
L3 HSTORE TEMP 7 0 TEMP 6
RETURN TEMP 7
END


MOVE TEMP 4 BEGIN
MOVE TEMP 9 HALLOCATE 4
MOVE TEMP 10 HALLOCATE 4
HSTORE TEMP 9 0 Printer_PrintPoint
MOVE TEMP 11 4
L4	CJUMP LE TEMP 11 3 L5
HSTORE PLUS TEMP 10 TEMP 11 0 0
MOVE TEMP 11 PLUS TEMP 11 4
JUMP L4
L5 HSTORE TEMP 10 0 TEMP 9
RETURN TEMP 10
END


MOVE TEMP 5 CALL BEGIN
MOVE TEMP 12 TEMP 2
HLOAD TEMP 13 TEMP 12 0
HLOAD TEMP 14 TEMP 13 0
RETURN TEMP 14
END ( TEMP 12 10 20 )

MOVE TEMP 5 CALL BEGIN
MOVE TEMP 15 TEMP 4
HLOAD TEMP 16 TEMP 15 0
HLOAD TEMP 17 TEMP 16 0
RETURN TEMP 17
END ( TEMP 15 TEMP 2 )

RETURN 0
END

Point_SetCoords [ 3 ]
BEGIN

HSTORE TEMP 0 4 TEMP 1

HSTORE TEMP 0 8 TEMP 2

RETURN 0
END

Point_GetX [ 1 ]
BEGIN

RETURN BEGIN
HLOAD TEMP 1 TEMP 0 4
RETURN TEMP 1
END

END

Point_GetY [ 1 ]
BEGIN

RETURN BEGIN
HLOAD TEMP 1 TEMP 0 8
RETURN TEMP 1
END

END

Printer_PrintPoint [ 2 ]
BEGIN

MOVE TEMP 2 CALL BEGIN
MOVE TEMP 4 TEMP 1
HLOAD TEMP 5 TEMP 4 0
HLOAD TEMP 6 TEMP 5 4
RETURN TEMP 6
END ( TEMP 4 )

MOVE TEMP 3 CALL BEGIN
MOVE TEMP 7 TEMP 1
HLOAD TEMP 8 TEMP 7 0
HLOAD TEMP 9 TEMP 8 8
RETURN TEMP 9
END ( TEMP 7 )

PRINT TEMP 2

PRINT TEMP 3

RETURN 0
END

