QS_Print [ 1 ]
BEGIN

MOVE TEMP 1 0
L24	CJUMP LE TEMP 1 MINUS BEGIN
HLOAD TEMP 2 TEMP 0 8
RETURN TEMP 2
END
 1 L26
CJUMP MINUS 1 LE TEMP 1 MINUS BEGIN
HLOAD TEMP 2 TEMP 0 8
RETURN TEMP 2
END
 1 L25

L25	
PRINT BEGIN
MOVE TEMP 4 PLUS BEGIN
HLOAD TEMP 3 TEMP 0 4
RETURN TEMP 3
END
 TIMES 4 TEMP 1
HLOAD TEMP 5 TEMP 4 4
RETURN TEMP 5
END



MOVE TEMP 1 PLUS TEMP 1 1


JUMP L24
L26	NOOP

RETURN 0
END

QS_Init [ 2 ]
BEGIN

HSTORE TEMP 0 8 TEMP 1

HSTORE TEMP 0 4 BEGIN
MOVE TEMP 2 HALLOCATE  TIMES  PLUS TEMP 1 1  4
MOVE TEMP 3 4
L27 CJUMP  LE TEMP 3 MINUS  TIMES  PLUS TEMP 1 1  4  1 L28
HSTORE  PLUS TEMP 2 TEMP 3 0  0
MOVE TEMP 3 PLUS TEMP 3 4
JUMP L27
L28 HSTORE TEMP 2 0 TEMP 1
RETURN TEMP 2
END


